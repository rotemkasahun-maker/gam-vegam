{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gam-vegam.rotemka.chatgpt.site/contracts/automation-event.json",
  "title": "גם וגם Automation Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "occurred_at", "dedupe_key", "priority"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "event_type": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "actor_user_id": {"type": ["string", "null"]},
    "target_user_id": {"type": ["string", "null"]},
    "object_type": {"type": ["string", "null"]},
    "object_id": {"type": ["string", "null"]},
    "context_id": {"type": ["string", "null"]},
    "payload": {"type": "object", "additionalProperties": true},
    "dedupe_key": {"type": "string", "minLength": 1},
    "priority": {"enum": ["low", "normal", "high", "urgent"]},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "deep_link": {"type": ["string", "null"]},
    "consent_scope": {"type": ["string", "null"]},
    "eligibility_hints": {"type": "object", "additionalProperties": true}
  }
}
